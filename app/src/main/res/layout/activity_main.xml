<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F6F5F1">
    <FrameLayout android:id="@+id/tempo_panel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@color/tempo_paused">
        <com.acgnu.dikdick.TempoDialView android:id="@+id/tempo_dial"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <ImageButton android:id="@+id/tempo_help" android:layout_width="48dp"
            android:layout_height="48dp" android:layout_gravity="top|end"
            android:layout_margin="8dp" android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_help" android:contentDescription="@string/tempo_help_title" />
    </FrameLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <com.acgnu.dikdick.ScrollDelListView android:id="@+id/listview"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="#E5E7E0" android:dividerHeight="1dp"
            android:paddingBottom="150dp" android:clipToPadding="false" />
        <TextView android:id="@+id/empty_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:gravity="center" android:text="还没有节拍\n旋转圆环调速，点击 + 保存为预设"
            android:textSize="14sp" android:textColor="#7B827C" android:lineSpacingExtra="10dp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|end" android:layout_margin="20dp" android:orientation="vertical">
            <ImageButton android:id="@+id/save_preset" style="@style/TempoActionButton"
                android:layout_marginBottom="12dp" android:src="@drawable/ic_save"
                android:contentDescription="保存当前预设的 BPM" android:visibility="gone" />
            <ImageButton android:id="@+id/add_preset" style="@style/TempoActionButton"
                android:src="@drawable/ic_add" android:contentDescription="新增节拍" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
